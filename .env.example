# General
LOG_LEVEL=INFO
LOG_JSON=true

# Redis (docker-compose overrides this to redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400

# Upstream Hospital Directory API
HOSPITAL_API_BASE_URL=https://hospital-directory.onrender.com
HOSPITAL_API_TIMEOUT_SECONDS=60
HOSPITAL_API_MAX_RETRIES=3
HOSPITAL_API_BACKOFF_BASE_SECONDS=0.5
HOSPITAL_API_BACKOFF_MAX_SECONDS=8

# CSV limits
MAX_CSV_ROWS=20
MAX_UPLOAD_BYTES=1048576

# Concurrency
PER_JOB_CONCURRENCY=5
UPSTREAM_MAX_IN_FLIGHT=10
UPSTREAM_SLOT_TTL_SECONDS=120

# Worker
WORKER_MAX_JOBS=10
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_MAX_TRIES=3
WORKER_DRAIN_SECONDS=75

# Server-Sent Events progress stream
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15

# Policy: activate a batch even if some rows failed?
ACTIVATE_ON_PARTIAL_FAILURE=false
